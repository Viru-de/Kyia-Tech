# ==============================================================================
# KLYIA TECHNOLOGY CRM — ENVIRONMENT CONFIGURATION TEMPLATE
# Configure these variables in Hostinger Node.js Application Manager or .env
# ==============================================================================

# 1. APP & DOMAIN CONFIGURATION
PORT="3000"
NODE_ENV="production"
APP_URL="https://your-crm-domain.com"

# 2. HOSTINGER MYSQL DATABASE CONFIGURATION
# (Obtain from Hostinger hPanel -> Databases -> Management)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u123456789_klyia_db"
DB_USER="u123456789_klyia_user"
DB_PASSWORD="your_strong_mysql_password_here"

# 3. INITIAL ADMINISTRATOR ACCOUNT SETUP
# Login Email: klyiatechnology@gmail.com
# Initial Password: Used on first application boot to provision administrator password hash in MySQL
ADMIN_PASSWORD="YourSecureAdminPassword2026!"

# 4. SESSION SECURITY
SESSION_SECRET="KlyiaCRM-8vQ2mN7xR4pL9kT6wY3hF5sB1dJ0cZ8aG2uE6rX9"

# 5. SMTP EMAIL DELIVERY (REQUIRED FOR AUTOMATED PASSWORD RECOVERY)
# (Obtain from Hostinger hPanel -> Emails -> Connect Apps & Devices)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@klyiatechnology.com"
SMTP_PASSWORD="your_smtp_email_account_password"
SMTP_FROM="Klyia Technology <noreply@klyiatechnology.com>"

# 6. OPTIONAL AI & EXTERNAL SERVICES
GEMINI_API_KEY="your_optional_gemini_api_key_if_used"
